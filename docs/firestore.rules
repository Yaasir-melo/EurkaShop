rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /appConfig/{configId} {
      allow get: if configId == 'catalog';
      allow list: if false;
      allow create, update, delete: if configId == 'catalog' && isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['title', 'description', 'price', 'category', 'image', 'inStock', 'rating', 'reviews', 'reviewsList'])
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.image is string;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /productReviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['productId', 'userId', 'name', 'rating', 'comment', 'createdAt'])
        && request.resource.data.keys().hasAll(['productId', 'userId', 'name', 'rating', 'comment', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.productId is int
        && request.resource.data.productId > 0
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 5
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /orderRequests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['userId', 'email', 'fullName', 'phone', 'address', 'items', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['userId', 'email', 'fullName', 'phone', 'address', 'items', 'status', 'createdAt'])
        && (request.auth.token.email_verified == true || isAdmin())
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 40
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && request.resource.data.address.size() <= 500
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow get, list: if isAdmin()
        || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['pending', 'confirmed', 'preparing', 'out_for_delivery', 'cancelled', 'fulfilled'];
      allow delete: if isAdmin();
    }

    // Email documents are created only by trusted Cloud Functions/Admin SDK.
    match /mail/{emailId} {
      allow read, write: if false;
    }
  }
}
